# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
*.egg-info/

# Build output. The two HTML files ARE the product, but they are generated: build them with
# `node app/rebuild_viewers.mjs`, and attach them to a release rather than committing them.
/Ipsissima.html
/Ipsissima Reader.html
app/desktop/dist/
app/desktop/src-tauri/target/
app/desktop/src-tauri/gen/
samples/**/*(map).html
# Built from the display fixtures while checking a rendering change; the .argdown is the fixture.
fixtures/**/*(map).html

# The platform icon set is regenerated from icons/source.png with `npx tauri icon`.
app/desktop/src-tauri/icons/*.png
app/desktop/src-tauri/icons/*.ico
app/desktop/src-tauri/icons/*.icns
!app/desktop/src-tauri/icons/source.png

.DS_Store

# Editor and assistant scratch. `.claude/` in particular is per-person tooling, not project
# configuration — someone else's launch config is not a thing to inherit.
.claude/
.vscode/
.idea/

# The public site is assembled by site/build_site.mjs at deploy time, for the same reason the two
# HTML files above are not committed: they are generated, and 2.5 MB of them per release would
# live in git for ever. `site/index.md` and `site/_config.yml` ARE the site and are committed.
site/ipsissima.html
site/ipsissima-reader.html
site/try/
site/_data/
site/_site/
