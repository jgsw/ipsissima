        mapping:      {label: "Flows, resource dependencies and inter-relations are mapped at system level", actor: policymakers, role: intervention, aspect: activity}
        loss:         {label: "Avoidable loss of health grows as the queue lengthens", actor: patients, aspect: quantity}
        volume:       {label: "Surgeons perform a procedure often", actor: hospitals, aspect: activity}
        complications: {label: "Surgical complications", actor: patients, aspect: quantity}
        centralise:   {label: "Policymakers are pushed to centralise complex surgery", actor: policymakers, aspect: activity}
        subsystems:   {label: "Sub-elements, themselves systems, several layers deep", levels: [services], aspect: condition}
        denied:       {label: "Patients are denied life-saving care another reasonable process would have given them", actor: patients, aspect: event}
        challenge:    {label: "They question the ethical justifiability of the process", actor: patients, aspect: activity}
        overuse:      {label: "A photocopier is run past its monthly work cycle", actor: office, design: illustration, aspect: activity}
        breakdown:    {label: "The photocopier breaks down and needs an engineer", actor: office, aspect: event}
        savings:      {label: "The reform's cost savings", actor: hospitals, aspect: quantity}
        careelse:     {label: "Patient care improves elsewhere in the system", actor: nhs, aspect: condition}
        limitcare:    {label: "Clinicians practise without being able to give good enough care", actor: clinicians, aspect: activity}
        interact:     {label: "Waiting problems across the NHS interact and exacerbate each other", levels: [services], aspect: activity, kind: spread,
                       note: "the text's problems that 'interact with and exacerbate each other', which its 'Thus' makes a case of scarcity spreading (p. 359)"}
        # what makes the system up (pp. 352, 359-360): constitution, not steps
        elementce:    {label: "Each element's performance and cost-effectiveness, measured separately", levels: [services], aspect: quantity}
        interactions: {label: "Elements interact, hierarchically and horizontally, through multiple feedback loops", levels: [services], aspect: activity}
        systemce:     {label: "How effective the system as a whole is at its core functions", actor: nhs, aspect: quantity}
