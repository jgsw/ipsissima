===
title: "Wilson 2023 -- What makes a health system good? From cost-effectiveness analysis to ethical improvement in health systems"
author: James Wilson
reconstruction:
    generated: true
    aim: fit
    unit: meaning
    mode: coherence
    strength: ordinary
    method: parallel
defaults:
    chapter: "source/wilson-2023-what-makes-a-health-system-good.md"
mechanism:
    question: "What does improving a health system element by element, centred on cost-effectiveness, do to the system as a whole -- and how else are its means and values improved?"
    contrast: "improvement centred on the cost-effectiveness of each element"
    # WHAT THE STATES ARE TOLD AS (profile 1.18): the text's definition of a flow, which nearly every state
    # is; said once for the chart. It was a state spanning all three levels that no step reached.
    idiom: {term: "flows", means: "processes by which inputs are transformed into outputs within a system: money, referral journeys, health information", pinpoint: "p. 352"}
    levels: [system, services, people]
    ordering: mixed          # the reconstructor's reading (profile 1.11 pass): "interlinked subsystems, some of which are arranged hierarchically, and others that interact without formally specified chains of authority" (p. 359)
    chains:
        congestion:  {label: "Demand beyond capacity: congestion and implicit rationing", question: "What follows when the system lets in more demand than it can serve, under a partial use of cost-effectiveness analysis?", goal: attribute}
        cascade:     {label: "From social care to ambulance response: one trajectory", question: "How does a lack of social care resources ramify into worse ambulance response times?"}
        scarcity:    {label: "Scarcity cascades, in general", question: "How can scarcity in one narrow domain worsen scarcity elsewhere?"}
        lean:        {label: "Leanness and brittleness", question: "Why is a system made maximally cost-effective brittle?"}
        proximity:   {label: "Proximity and surgical outcomes", question: "Why is the value of proximity in tension with minimising surgical complications?",
                      apart: "the text's example of a value in tension with minimising complications (p. 353); it says nothing of how centralising bears on the system's other chains"}
        cataract:    {label: "Waiting for a progressive condition: cataract surgery", question: "Why do cataract waiting lists feed themselves, and what does waiting do to patients and to cost-effectiveness?"}
        dynamic:     {label: "Effects and rankings that do not hold still", question: "Why do the effects and rankings cost-effectiveness analysis relies on shift with the system?",
                      apart: "two assumptions the text rejects one after the other (pp. 354-356): external validity, since changes elsewhere shift an intervention's effects; and static ranking, since changing circumstances shift which ranking is right. Each is a general step with its cases"}
        improvement: {label: "Means and values, each improving the other", question: "How are a health system's means and values improved, each through the other?", form: cycle, settles: false}
        staff:       {label: "The human elements of the system", question: "What do workload and institutional pressure do to clinicians, and to care?",
                      apart: "the photocopier is the text's contrast case, set against clinicians by argument ('Human beings are not replaceable', p. 362), not joined to them by any step"}
    kinds:
        localscarce: {label: "Scarcity in one part of the system", general: localscarcity}
        spread:      {label: "Scarcity spreading elsewhere in the system", general: cascade}
        waits:       {label: "Waiting times growing", general: waiting}
        context:     {label: "A change in the system around an intervention", general: syschange}
        effect:      {label: "What an intervention achieves, and at what cost", general: effects}
        circ:        {label: "A change in the circumstances a prioritisation assumed", general: circumstances}
        rank:        {label: "Which prioritisation is right", general: ranking}
    actors:
        nhs:          {label: "The health system as a whole: the English NHS", level: system}
        policymakers: {label: "Policymakers", level: system}
        public:       {label: "Citizens, deliberating together", level: system}
        socialcare:   {label: "Social care services", level: services}
        hospitals:    {label: "Hospitals: wards, beds and services", level: services}
        ae:           {label: "Accident and Emergency departments", level: services}
        ambulances:   {label: "The ambulance service", level: services}
        callhandlers: {label: "Emergency call handlers", level: services}
        cataract:     {label: "Cataract surgery services", level: services}
        patients:     {label: "Patients", level: people}
        clinicians:   {label: "Clinicians and other healthcare staff", level: people}
        office:       {label: "An office and its photocopier", level: services}
    states:
        # demand beyond capacity (pp. 354, 357-358, 363)
        partialcea:   {label: "The NHS uses cost-effectiveness analysis partially: new interventions admitted at a threshold, few stopped", actor: nhs, role: condition, aspect: condition}
        gap:          {label: "Policymakers let more demand into the system than it can serve", actor: policymakers, role: condition, aspect: activity,
                       note: "the text's 'systemic gap ... between the demands that individuals can make under the system, and the system's ability to meet these demands' (p. 358), read as the letting-in that opens it"}
        congestion:   {label: "Services congest: waits grow ever longer, for surgery and for moving patients out of ambulances", actor: nhs, aspect: activity,
                       note: "the text's 'system congestion' and 'implicit rationing' read as one state: queuing and congestion are its forms (p. 357)"}
        unmet:        {label: "Unmet healthcare needs increase", actor: patients, aspect: quantity}
        private:      {label: "Patients who can afford it pay for private treatment", actor: patients, aspect: activity}
        harm:         {label: "Patients come to harm, on a large scale", actor: patients, role: outcome}
        qalyloss:     {label: "New interventions lose more health than they create", actor: nhs, aspect: quantity}
        # one trajectory of cascading scarcity (p. 360)
        socialcare:   {label: "Social care lacks the resources to care for patients safely outside hospital", actor: socialcare, role: condition, aspect: condition, kind: localscarce}
        discharge:    {label: "Patients well enough to leave wait in hospital beds to be discharged", actor: patients, aspect: activity}
        aeexit:       {label: "Patients wait in A&E to be moved onto wards", actor: ae, aspect: activity}
        ambwait:      {label: "Patients wait in ambulances outside the hospital to be admitted", actor: patients, aspect: activity}
        outofservice: {label: "Ambulances are out of service while they wait with patients in hospital car parks", actor: ambulances, aspect: condition, kind: spread}
        response:     {label: "Ambulances take longer to respond", actor: ambulances, aspect: quantity, kind: spread,
                       measured: "mean response times against targets: Category 1 10 min 33 s against 7 min, Category 2 51 min against 18 min, June 2022 (n. 8)"}
        callload:     {label: "Call handlers take repeated calls about ambulances that have not arrived", actor: callhandlers, aspect: activity, role: outcome}
        # scarcity cascades, in general (pp. 351, 359-360): processes with no owner
        localscarcity: {label: "Scarcity in one narrow domain of the system", levels: [services], role: condition, aspect: condition, kind: localscarce}
        bottleneck:   {label: "Bottlenecks form", levels: [services], aspect: event}
        cascade:      {label: "Scarcity cascades: other parts of the system perform worse", levels: [services], role: outcome, aspect: activity, kind: spread}
        # leanness (pp. 351, 353)
        valueformoney: {label: "Policymakers focus only on value for money", actor: policymakers, role: condition, aspect: activity}
        lean:         {label: "Policymakers make the system lean: eliminating waste and spare capacity, just in time", actor: policymakers, aspect: activity}
        flex:         {label: "The system can flex to meet a surge in demand, such as a public health emergency", actor: nhs, role: outcome, aspect: condition}
        # waiting for a progressive condition (pp. 358-359)
        fcfs:         {label: "Access is first come, first served", actor: hospitals, role: condition, aspect: condition}
        waiting:      {label: "Waiting times grow ever longer", actor: nhs, aspect: quantity, kind: waits}
        cataractwait: {label: "Patients wait longer for cataract surgery, and the list grows", actor: cataract, aspect: quantity, kind: waits,
                       measured: "mean wait 278 days in 2021, against an 18-week target; up 35% in 2019-20 and 36% in 2020-21 in 12 trusts (Eyewire 2021)"}
        newdiag:      {label: "More people are diagnosed with cataracts each week", actor: patients, role: condition, aspect: activity}
        removal:      {label: "Patients leave the list: operated on, going private, dying or emigrating", actor: cataract, role: condition, aspect: activity}
        pandemic:     {label: "The pandemic diverts resources from non-Covid treatment", actor: nhs, role: condition, aspect: event}
        displacement: {label: "Urgent cases displace non-urgent ones from the system's capacity", actor: hospitals, role: condition, aspect: activity}
        worsen:       {label: "Patients' cataracts worsen while they wait", actor: patients, aspect: development}
        casetime:     {label: "Operations become more complex, take longer and bring more complications", actor: cataract, aspect: quantity}
        qol:          {label: "Waiting patients' quality of life", actor: patients, role: outcome, aspect: quantity}
        accidents:    {label: "Patients lose the ability to drive, and have more accidents", actor: patients, aspect: activity}
        cataractce:   {label: "How cost-effective the cataract service is", actor: cataract, role: outcome, kind: effect, aspect: quantity}
        # effects and rankings that do not hold still (p. 356)
        adherence:    {label: "Patients are supported to adhere to their treatment", actor: patients, role: condition, kind: context, aspect: activity}
        drugce:       {label: "A drug's effectiveness and cost-effectiveness in practice", actor: nhs, role: outcome, kind: effect, aspect: quantity}
        beyond:       {label: "Patient flows exceed the parameters services were calibrated for", actor: hospitals, role: condition, kind: circ, aspect: condition,
                       note: "the text's examples: 300 beds sufficing even at moments of high demand; A&E processing no more than 40 patients an hour"}
        calibration:  {label: "Which calibration of services is most cost-effective", actor: hospitals, role: outcome, kind: rank, aspect: condition}
        change:       {label: "Waiting patients' conditions change, relative to their own baseline and to one another", actor: patients, role: condition, kind: circ, aspect: development}
        fairorder:    {label: "The waiting list's order stays fair", actor: hospitals, role: outcome, kind: rank, aspect: condition}
        syschange:    {label: "Changes elsewhere in the health system", actor: nhs, aspect: activity, kind: context}
        effects:      {label: "An intervention's effects, and hence its cost-effectiveness", actor: nhs, aspect: quantity, kind: effect}
        circumstances: {label: "Circumstances relevant to prioritisation change within a round of allocation", actor: nhs, aspect: event, kind: circ}
        ranking:      {label: "Which prioritisation ranking is right", actor: nhs, aspect: condition, kind: rank}
        # means and values, each improving the other (pp. 361-363): a cycle
        valuesimp:    {label: "Values-improvement: specifying and reconciling the values the system should instantiate and promote", levels: [system], aspect: activity}
        meansimp:     {label: "Means-improvement: reconfiguring flows so the system as a whole better achieves its values, every day and at every level", levels: [system, services, people], aspect: activity}
        tre:          {label: "Anonymisation technologies improve and Trusted Research Environments are built", actor: nhs, part_of: meansimp, aspect: activity,
                       note: "the text's example of means-improvement that opens up new possibilities (p. 361)"}
        reconcile:    {label: "Confidentiality and research on linked patient data can be reconciled", actor: nhs, part_of: valuesimp, aspect: condition}
        infeasible:   {label: "The system cannot deliver what values-improvement specified, even after diligent means-improvement", actor: nhs, role: condition, aspect: condition}
        deliberation: {label: "The public deliberates about the system's goals", actor: public, role: condition, aspect: activity}
        norms:        {label: "Healthcare's practice norms: restoring health, relieving suffering, care, confidentiality", actor: clinicians, aspect: condition,
                       note: "the text's 'core normative expectations' of healthcare as a social practice (p. 362), which clinicians are socialised into"}
        sideline:     {label: "Practice norms are ignored or sidelined in the pursuit of cost-effectiveness", actor: policymakers, role: condition, aspect: activity}
        cutoff:       {label: "Ends and values are cut off from the ongoing process", levels: [system], role: condition, aspect: condition}
        fixation:     {label: "They become arrests, fixations", levels: [system], role: outcome, aspect: condition}
        # the human elements (pp. 362-363)
        overwork:     {label: "Staff work beyond a safe workload over a prolonged period", actor: clinicians, role: condition, aspect: activity}
        injury:       {label: "Staff suffer moral injury and break down", actor: clinicians, role: outcome, aspect: event}
        turnover:     {label: "Sick leave and staff turnover increase", actor: clinicians, role: outcome, aspect: quantity}
        subordinate:  {label: "Institutional arrangements subordinate goods internal to medicine to external goods", actor: nhs, role: condition, aspect: condition}
        distress:     {label: "Good doctors feel tension and moral distress", actor: clinicians, role: outcome, aspect: condition}
        reform:       {label: "A ward gives each clinician responsibility for more patients", actor: hospitals, role: condition, aspect: event}
        relationship: {label: "Clinicians can establish a personal relationship with patients", actor: clinicians, aspect: condition}
        stress:       {label: "Workplace stress", actor: clinicians, aspect: quantity}
        overtime:     {label: "Conscientious clinicians work creeping unpaid overtime", actor: clinicians, aspect: activity}
        quality:      {label: "The quality of care on the ward", actor: hospitals, role: outcome, aspect: condition}
