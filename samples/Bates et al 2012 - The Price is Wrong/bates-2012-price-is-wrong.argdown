                     measured: "administrative cost per child dewormed"}
        costeff:    {label: "Programme's cost-effectiveness, from society's side", actor: agency,
                     note: "Kept apart from cost per person because the text counts the costs to the poor and the lives saved as well."}
        effort:     {label: "Providers keep stock and come to work", actor: provider}
        leak:       {label: "Health workers sell products meant to be free", actor: provider}
        cash:       {label: "Cash on hand", actor: household,
