        distance:   {label: "Distance and inconvenience of getting the product", actor: household}
        deliberate: {label: "Effort of deciding whether to buy", actor: household}
        need:       {label: "Household's need for the product", actor: household,
                     measured: "worm load; anemia in pregnant women; number of young children"}
        takeup:     {label: "Household takes the product up", actor: household,
                     measured: "purchases, voucher redemptions, treatment received",
                     note: "The text's 'take-up', 'adoption', 'access', 'demand', 'sales', 'purchase' and 'willingness to pay' read as one state."}
        use:        {label: "Product used", actor: household,
