[Aim]: Things happen.

[A1]: X raises Y. {fidelity: "compression", causes: {from: x, to: y, sign: "+", basis: asserted, chain: a}}
    +> [Aim]

[B1]: Y raises Z. {fidelity: "compression", causes: {from: y, to: z, sign: "+", basis: asserted, chain: b}}
    +> [Aim]

[C1]: U raises V; S raises T. {fidelity: "compression", causes: [{from: u, to: v, sign: "+", basis: asserted, chain: c}, {from: s, to: t, sign: "+", basis: asserted, chain: c}]}
    +> [Aim]

